{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tickadoo-mcp",
	"main": "src/worker.ts",
	"compatibility_date": "2026-03-10",
	"compatibility_flags": ["nodejs_compat"],
	"account_id": "e4374ada916c35df9b0090cea132b65b",
	"keep_vars": true,
	"workers_dev": true,
	"preview_urls": false,
	"observability": {
		"enabled": true
	},
	"routes": [
		{
			"pattern": "mcp.tickadoo.com",
			"custom_domain": true
		}
	],
	"vars": {
		"ENVIRONMENT": "production"
	}
}
