{
  "name": "@tickadoo/mcp-server",
  "version": "2.2.0",
  "description": "tickadoo MCP Server: a thin stdio bridge to the live remote MCP server at https://mcp.tickadoo.com/mcp. No API key required.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-server": "dist/index.js"
  },
  "files": [
    "dist/index.js",
    "plugin.json",
    "mcp.json",
    ".codex-plugin/plugin.json",
    ".claude-plugin/",
    ".mcp.json",
    "clients/github-copilot/mcp.json",
    "clients/anthropic-managed-agents/agent.json",
    "brand/apps-directory-icon.svg",
    "brand/apps-directory-icon-monochrome.svg",
    "skills/",
    "schemas/agent-plugins/1.0.0/",
    "evals/agent-plugin-scenarios.json",
    "metadata/public-agent-tools.json",
    "docs/agent-plugins.md",
    "docs/openai-plugin-submission.md",
    "server.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node -e \"const fs = require('node:fs'); fs.rmSync('dist', { recursive: true, force: true }); fs.mkdirSync('dist', { recursive: true });\" && ./node_modules/.bin/esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --target=node22 --outfile=dist/index.js",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "sync:server-json": "node scripts/sync-server-json.mjs",
    "sync:public-agent": "node scripts/sync-public-agent-contract.mjs",
    "verify:public-agent": "node scripts/verify-public-agent-contract.mjs",
    "build:openai-zip": "node scripts/build-openai-plugin-zip.mjs",
    "test": "vitest run",
    "test:plugin": "vitest run tests/agent-plugin.test.ts tests/agent-plugin-distribution.test.ts tests/openai-plugin-security.test.ts tests/public-agent-contract.test.ts",
    "smoke:agents-api": "tsx examples/agents-api-tickadoo-smoke.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "tickadoo",
    "tickets",
    "theatre",
    "events",
    "experiences",
    "booking",
    "travel",
    "tours",
    "attractions",
    "ai-agent",
    "model-context-protocol",
    "remote",
    "stdio",
    "bridge"
  ],
  "author": "tickadoo Inc.",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "openai": "^7.43.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12",
    "zod": "^4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tickadoo/tickadoo-mcp.git"
  },
  "homepage": "https://mcp.tickadoo.com",
  "bugs": {
    "url": "https://github.com/tickadoo/tickadoo-mcp/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "esbuild": "$esbuild"
  }
}
